# Telegram
TG_BOT_TOKEN=
TG_ADMIN_ID=

# Polling
POLL_INTERVAL=30
# incoming transfers below this amount (stablecoin units) are treated as dust/scam
MIN_AMOUNT=1

# RPC endpoints (comma-separated, tried in order)
ETH_RPC=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
BSC_RPC=https://bsc-rpc.publicnode.com,https://bsc.drpc.org
TRONGRID_URL=https://api.trongrid.io
# optional, raises TronGrid rate limits (free at trongrid.io)
TRONGRID_API_KEY=

DB_PATH=tracker.db

# History: ETH via Routescan (free). BSC full history needs an Etherscan V2 key (paid for BSC);
# without it BSC history = transfers seen by the tracker since the address was added.
ETH_HISTORY_API=https://api.routescan.io/v2/network/mainnet/evm/1/etherscan/api
ETHERSCAN_API_KEY=
